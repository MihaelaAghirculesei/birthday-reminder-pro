rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Optional string field: absent, or a string of at most `max` characters.
    function optString(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    // Matches FirestoreService.mapBirthdayToFirestore. Limits stay looser than
    // the client schema on purpose: a write the client accepts but the rules
    // reject would stay stuck in the pending-changes queue.
    function isValidBirthday(userId, birthdayId) {
      let d = request.resource.data;
      return d.keys().size() <= 30
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 200
          && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.ownerId == userId
          && d.updatedAt is int
          && (!('id' in d) || d.id == birthdayId)
          && optString(d, 'notes', 2000)
          && optString(d, 'photo', 2048)
          && optString(d, 'rememberPhoto', 2048)
          && optString(d, 'category', 100)
          && optString(d, 'email', 320)
          && optString(d, 'phone', 50)
          && optString(d, 'telegramUsername', 64)
          && optString(d, 'zodiacSign', 50)
          && optString(d, 'googleCalendarEventId', 1024);
    }

    // Matches FirestoreService.performSaveCategory.
    function isValidCategory(userId, categoryId) {
      let d = request.resource.data;
      return d.keys().size() <= 15
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.ownerId == userId
          && d.updatedAt is int
          && (!('id' in d) || d.id == categoryId)
          && optString(d, 'color', 20)
          && optString(d, 'icon', 50);
    }

    match /users/{userId} {
      allow read:           if isOwner(userId);
      allow create, update: if isOwner(userId)
                             && request.resource.data.keys().size() <= 20;
      allow delete:         if isOwner(userId);

      match /birthdays/{birthdayId} {
        allow read:           if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBirthday(userId, birthdayId);
        allow delete:         if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow read:           if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCategory(userId, categoryId);
        allow delete:         if isOwner(userId);
      }

      // Written in every batch that changes user data (addRateLimitToBatch),
      // deleted on account deletion. Only a server timestamp is accepted.
      match /rateLimit/{docId} {
        allow read, delete:   if isOwner(userId);
        allow create, update: if isOwner(userId)
                               && docId == 'writes'
                               && request.resource.data.keys().hasOnly(['lastWrite'])
                               && request.resource.data.lastWrite == request.time;
      }

      match /settings/{settingId} {
        allow read:           if isOwner(userId);
        allow create, update: if isOwner(userId) && request.resource.data.keys().size() <= 30;
        allow delete:         if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
